# Opzioni del server GPStelemetry (/etc/default/gpstelemetry).
# Dopo una modifica: sudo systemctl restart gpstelemetry
#
# GPS_DATA     cartella di database e foto (install.sh --data la sposta sul disco esterno)
#
# -public-url    indirizzo HTTPS con cui l'app raggiunge il server (serve per i link alle foto)
# -addr          resta su 127.0.0.1: il server è raggiungibile da fuori solo tramite il tunnel
# -trust-proxy   legge l'IP del client dalle intestazioni del tunnel
# -batch-delay   attesa per raggruppare le scritture (più alta = meno scritture su disco)
# -max-inflight  richieste lavorate insieme; le altre attendono fino a -wait, poi 503
GPS_DATA=/var/lib/gpstelemetry
GPS_ARGS="-addr 127.0.0.1:8080 -public-url https://gps.example.com -trust-proxy -batch-delay 500ms -max-inflight 8 -wait 3s"
