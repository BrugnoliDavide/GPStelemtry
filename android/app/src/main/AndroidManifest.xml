<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Mappe (tile OSM) e Data Layer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- GPS ad alta precisione -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Registrazione con schermo spento -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GpsTelemetry">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TrackEditorActivity"
            android:label="@string/editor_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".TimerActivity"
            android:label="@string/timer_title"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SessionsActivity"
            android:label="@string/sessions_title" />

        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
