<?xml version="1.0" encoding="utf-8"?>
<!-- Contenitore delle schede + barra di navigazione in basso (stile Instagram). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/BottomNav.Indicator"
        app:itemIconSize="26dp"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextAppearanceActive="@style/BottomNav.Text"
        app:itemTextAppearanceInactive="@style/BottomNav.Text"
        app:itemTextColor="@color/bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
