<?xml version="1.0" encoding="utf-8"?>
<!-- Cronometro — VERTICALE. Stessi ID di layout-land/activity_timer.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Intestazione -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/IconButton.Glass"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tmState"
                style="@style/Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/state_idle" />

            <TextView
                android:id="@+id/tmTrackName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnRotate"
            style="@style/IconButton.Glass"
            android:contentDescription="@string/rotate"
            android:src="@drawable/ic_landscape" />
    </LinearLayout>

    <com.gpstelemetry.app.SectorBarView
        android:id="@+id/tmSectors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/tmClock"
        style="@style/Text.Clock"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="8dp"
        android:autoSizeMaxTextSize="200sp"
        android:autoSizeMinTextSize="40sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:text="00:00.0" />

    <TextView
        android:id="@+id/tmDelta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:minHeight="28dp"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tmOffTrack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_offtrack"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="@string/off_track"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Forma del tracciato con posizione corrente -->
    <com.gpstelemetry.app.TrackShapeView
        android:id="@+id/tmShape"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass"
        android:padding="8dp" />

    <!-- Telemetria -->
    <GridLayout
        android:id="@+id/tmGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass"
        android:columnCount="4"
        android:padding="6dp" />

    <!-- Comandi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Button.Glass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="@string/share"
            android:visibility="gone"
            app:icon="@drawable/ic_share"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            style="@style/Button.Start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:text="@string/start_tracking" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Button.Glass"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/stop_session"
            android:visibility="gone"
            app:icon="@drawable/ic_stop"
            app:iconTint="@color/sector_worse"
            />
    </LinearLayout>
</LinearLayout>
