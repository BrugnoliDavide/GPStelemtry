<?xml version="1.0" encoding="utf-8"?>
<!-- Scheda tracciato in vetro: forma del tracciato | nome e tipologie | tasto play. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_glass"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.gpstelemetry.app.TrackShapeView
        android:id="@+id/trackShape"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:background="@drawable/bg_glass_inner" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/trackName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="19sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/trackType"
                style="@style/Chip.Glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/trackLength"
                style="@style/Chip.Glass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/trackInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/trackBest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-condensed"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/sector_best"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnPlay"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_play_circle"
        android:contentDescription="@string/start_tracking"
        android:elevation="6dp"
        android:padding="15dp"
        android:paddingStart="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play"
        android:tint="@color/on_accent" />
</LinearLayout>
