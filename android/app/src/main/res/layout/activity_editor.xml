<?xml version="1.0" encoding="utf-8"?>
<!--
  Editor tracciato: mappa a tutto schermo con comandi in vetro.
  In alto: indietro, nome, salva; tipo e tolleranza.
  In basso: strumenti (partenza/traguardo/parziale, registrazione) oppure,
  con una linea selezionata, il pannello per orientarla e dimensionarla.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra superiore -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/IconButton.Glass"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <EditText
                android:id="@+id/edName"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-black"
                android:hint="@string/track_name_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="60"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/save" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/edTypeGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCircular"
                    style="@style/Chip.Editor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/track_type_circular" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOpen"
                    style="@style/Chip.Editor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/track_type_open" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTolerance"
                style="@style/Chip.Editor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checkable="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Centra sulla posizione / sul tracciato -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnFit"
            style="@style/IconButton.Glass"
            android:background="@drawable/bg_panel_circle"
            android:contentDescription="@string/editor_fit"
            android:src="@drawable/ic_fit" />

        <ImageButton
            android:id="@+id/btnMyLocation"
            style="@style/IconButton.Glass"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_panel_circle"
            android:contentDescription="@string/editor_my_location"
            android:src="@drawable/ic_my_location" />
    </LinearLayout>

    <!-- Pannello inferiore -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Strumenti -->
        <LinearLayout
            android:id="@+id/toolsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/edHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/editor_hint_idle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/pickGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnPickStart"
                    style="@style/Chip.Editor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_start" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnPickFinish"
                    style="@style/Chip.Editor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_finish" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnPickSplit"
                    style="@style/Chip.Editor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_split" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecordPath"
                    style="@style/Button.Glass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/record_path" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLiveCapture"
                    style="@style/Button.Glass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/live_capture" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLiveSplit"
                    style="@style/Button.Glass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/live_split"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/edStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Linea selezionata: orientamento e larghezza -->
        <LinearLayout
            android:id="@+id/gatePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gateTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gateRename"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rename"
                    android:textColor="@color/accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gateDelete"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_delete"
                    android:textColor="@color/sector_worse" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/editor_gate_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gateAngleLabel"
                    style="@style/Text.Label"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/gateAngle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="1"
                    android:valueFrom="0"
                    android:valueTo="179"
                    app:labelBehavior="gone"
                    app:tickVisible="false"
                    app:thumbColor="@color/accent"
                    app:trackColorActive="@color/accent"
                    app:trackColorInactive="@color/glass_top" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gateWidthLabel"
                    style="@style/Text.Label"
                    android:layout_width="92dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/gateWidth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:stepSize="1"
                    android:valueFrom="4"
                    android:valueTo="200"
                    app:labelBehavior="gone"
                    app:tickVisible="false"
                    app:thumbColor="@color/accent"
                    app:trackColorActive="@color/accent"
                    app:trackColorInactive="@color/glass_top" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gatePerpendicular"
                    style="@style/Button.Glass.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/editor_perpendicular" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gateDone"
                    style="@style/Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/done" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
