<?xml version="1.0" encoding="utf-8"?>
<!-- Scheda in vetro smerigliato: riempimento traslucido sfumato, bordo sottile e riflesso in alto. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/glass_top"
                android:endColor="@color/glass_bottom" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
    <!-- Riflesso: sottile luce sul bordo superiore. -->
    <item
        android:left="24dp"
        android:right="24dp"
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@android:color/transparent"
                android:centerColor="@color/glass_highlight"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
