<?xml version="1.0" encoding="utf-8"?>
<!--
  Cronometro — ORIZZONTALE (dashboard): barra dei settori in alto, tempo
  enorme al centro, telemetria e comandi in basso.
  Stessi ID di layout/activity_timer.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <!-- Intestazione compatta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/IconButton.Glass"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tmTrackName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxWidth="260dp"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tmState"
            style="@style/Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/state_idle" />

        <TextView
            android:id="@+id/tmOffTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_offtrack"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:text="@string/off_track"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnRotate"
            style="@style/IconButton.Glass"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:contentDescription="@string/rotate"
            android:src="@drawable/ic_landscape" />
    </LinearLayout>

    <!-- Barra dei settori -->
    <com.gpstelemetry.app.SectorBarView
        android:id="@+id/tmSectors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />

    <!-- Tempo grande + forma del tracciato -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tmClock"
                style="@style/Text.Clock"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="400sp"
                android:autoSizeMinTextSize="40sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:text="00:00.0" />

            <TextView
                android:id="@+id/tmDelta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:minHeight="28dp"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.gpstelemetry.app.TrackShapeView
            android:id="@+id/tmShape"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_glass"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Telemetria + comandi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <GridLayout
            android:id="@+id/tmGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_glass"
            android:columnCount="8"
            android:padding="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Button.Glass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/share"
            android:visibility="gone"
            app:icon="@drawable/ic_share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            style="@style/Button.Start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingStart="24dp"
            android:paddingEnd="28dp"
            android:text="@string/start_tracking" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Button.Glass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/stop_session"
            android:visibility="gone"
            app:icon="@drawable/ic_stop"
            app:iconTint="@color/sector_worse" />
    </LinearLayout>
</LinearLayout>
